# Flask Configuration
FLASK_ENV=development
PORT=5000
LOG_LEVEL=INFO

# API Keys (Optional - system works without these but with limited functionality)
# Get NewsAPI key from: https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here

# People Data Labs API Key (Optional)
# Get from: https://www.peopledatalabs.com/
PDL_API_KEY=your_pdl_api_key_here

# Crunchbase API Key (Optional - for future enhancement)
# Get from: https://www.crunchbase.com/
CRUNCHBASE_API_KEY=your_crunchbase_api_key_here

# LinkedIn API Credentials (Optional - very restricted access)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Application Settings
MAX_REQUESTS_PER_MINUTE=60
CACHE_TIMEOUT_SECONDS=3600
DEFAULT_CONFIDENCE_THRESHOLD=0.3

# Database Configuration (Optional - for caching)
DATABASE_URL=sqlite:///promoter_cache.db

# Security Settings
SECRET_KEY=your_secret_key_here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_STORAGE_URL=memory://
RATE_LIMIT_PER_HOUR=1000